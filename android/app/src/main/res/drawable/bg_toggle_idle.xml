<?xml version="1.0" encoding="utf-8"?>
<!-- Круглая кнопка-тумблер: состояние «остановлен» — контур -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22D946A6">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FBFAFD" />
            <stroke
                android:width="2.5dp"
                android:color="@color/crystal_mid" />
        </shape>
    </item>
</ripple>
