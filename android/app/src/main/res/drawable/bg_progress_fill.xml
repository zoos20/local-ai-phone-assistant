<?xml version="1.0" encoding="utf-8"?>
<!-- Прогресс-бар качки модели: трек + градиентная заливка с обрезкой по уровню -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#E4E2EC" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#E9C7E4" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/crystal_start"
                    android:endColor="@color/crystal_end"
                    android:type="linear" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
