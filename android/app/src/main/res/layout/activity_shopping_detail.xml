<?xml version="1.0" encoding="utf-8"?>
<!-- Гемма — детали списка покупок: позиции с чекбоксами (вычеркнуто —
      зачёркнутый серый текст в коде), добавление позиции, «Удалить список».
      Состояния те же, что у списка: загрузка/данные/пусто/нет связи.
      Стиль един с activity_shopping_lists.xml / activity_settings.xml:
      шапка 20dp отступа (как у главного), «Обновить» — тихий borderless-
      экшен, градиентная заливка только у главной CTA «Добавить». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Шапка: назад + имя списка + обновить (тихий borderless-экшен) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Список покупок"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- id не меняется: используется в ShoppingDetailActivity (load()) -->
        <Button
            android:id="@+id/btnRefresh"
            style="@style/Widget.Gemma.TextAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Обновить" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/status_idle"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Позиции списка (зазор между строками — divider, как в списке списков) -->
    <ListView
        android:id="@+id/lvItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="#00000000"
        android:dividerHeight="8dp"
        android:listSelector="?attr/selectableItemBackground"
        android:paddingBottom="8dp" />

    <!-- Добавление позиции -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Новая позиция"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Текст"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etQty"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input"
                android:hint="Кол-во"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Главная CTA экрана: градиент кристалла, тач-таргет ≥48dp -->
        <Button
            android:id="@+id/btnAdd"
            style="@style/Widget.Gemma.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="Добавить"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Долгое нажатие — изменить или удалить позицию"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Удаление списка: подтверждение — AlertDialog в ShoppingDetailActivity.
         Деструктивное действие — то же «тихое» поле bg_input, магента-текст
         (status_error), как было: без красной палитры, язык один. -->
    <Button
        android:id="@+id/btnDeleteList"
        style="@style/Widget.Gemma.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:backgroundTint="@null"
        android:minHeight="48dp"
        android:text="Удалить список"
        android:textColor="@color/status_error"
        android:textSize="15sp" />
</LinearLayout>
