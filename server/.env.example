# --- llama.cpp (Gemma) ---
ASSISTANT_LLM_BASE_URL=http://192.168.1.100:8080/v1
ASSISTANT_LLM_API_KEY=sk-local-change-me
ASSISTANT_LLM_MODEL=gemma4-e4b-unc

# --- Telegram (Telethon, user session) ---
# Получить на https://my.telegram.org -> API development tools
ASSISTANT_TG_API_ID=
ASSISTANT_TG_API_HASH=
# Путь к файлу сессии (создаётся при первом запуске, нужен вход в аккаунт)
ASSISTANT_TG_SESSION=data/tg_user

# --- VK ---
# Токен с правом messages (подтверждённое приложение или access_token сообщества)
ASSISTANT_VK_TOKEN=

# --- Поиск ---
# 'duckduckgo' — без ключей; 'brave' — требует ASSISTANT_BRAVE_API_KEY
ASSISTANT_SEARCH_PROVIDER=duckduckgo
ASSISTANT_BRAVE_API_KEY=

# --- Сервер ---
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8090

# --- Доступ из интернета (туннель, tunnel.py: wss://:8443/tunnel) ---
# Общий секрет: телефон шлёт его в заголовке X-Gemma-Token и при открытии
# канала. Пусто = токен не нужен (только LAN, как раньше), туннель выключен.
ASSISTANT_API_TOKEN=
# Порты/сертификат туннеля (сертификат создаётся сам при старте tunnel.py)
ASSISTANT_TUNNEL_HOST=0.0.0.0
ASSISTANT_TUNNEL_PORT=8443
ASSISTANT_TUNNEL_CERT=data/tunnel_cert.pem
ASSISTANT_TUNNEL_KEY=data/tunnel_key.pem
# DDNS: AAAA-запись ПК (бесплатный https://dynv6.com), её обновляет
# scripts/ddns-update.ps1 (задача каждые 5 мин -- scripts/setup-ddns-task.ps1)
ASSISTANT_DDNS_HOSTNAME=
ASSISTANT_DDNS_TOKEN=
